rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- Suggestion Rules ---
    match /suggestions/{suggestionId} {
      allow read: if true; // Publicly readable for the feed
      allow create: if isSignedIn() && isValidSuggestion(incoming()) && incoming().user_id == request.auth.uid;
      allow update: if isSignedIn() && (
        // Admin or owner can update
        isOwner(existing().user_id) && isValidSuggestion(incoming()) && (
          incoming().diff(existing()).affectedKeys().hasOnly(['votes', 'energy', 'status', 'built_code', 'pledged_by', 'history', 'chat_thread', 'is_deleted'])
        ) ||
        // Anyone can vote
        (incoming().diff(existing()).affectedKeys().hasOnly(['votes']) && incoming().votes == existing().votes + 1) ||
        // Anyone can pledge
        (incoming().diff(existing()).affectedKeys().hasOnly(['pledged_by']) && incoming().pledged_by.size() > existing().pledged_by.size())
      );
      allow delete: if isOwner(existing().user_id);
    }

    function isValidSuggestion(data) {
      return data.content is string && data.content.size() <= 50000 &&
             data.status is string &&
             (!('user_id' in data) || data.user_id is string);
    }

    // --- User Profile Rules ---
    match /user_profiles/{userId} {
      allow read: if true;
      allow write: if isOwner(userId) && isValidUserProfile(incoming());
    }

    function isValidUserProfile(data) {
      return data.id == request.auth.uid &&
             (!('full_name' in data) || (data.full_name is string && data.full_name.size() <= 100)) &&
             (!('personal_api_key' in data) || data.personal_api_key is string);
    }

    // --- Advice Rules ---
    match /advice/{adviceId} {
      allow read: if true;
      allow create: if isSignedIn() && incoming().user_id == request.auth.uid;
      allow delete: if isOwner(existing().user_id);
    }

    // --- System Messages ---
    match /system_messages/{messageId} {
      allow read: if true;
      allow create: if isSignedIn() && incoming().userId == request.auth.uid;
      allow delete: if isOwner(existing().userId);
    }
  }
}
